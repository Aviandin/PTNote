
import sys
import json
from pathlib import Path

from PySide6.QtCore import Qt
from PySide6.QtGui import QIcon, QPixmap, QColor, QPalette, QFont
from PySide6.QtWidgets import (
    QApplication,
    QWidget,
    QTextEdit,
    QPushButton,
    QHBoxLayout,
    QVBoxLayout,
    QSystemTrayIcon,
    QMenu,
    QColorDialog,
    QDialog,
    QCheckBox,
    QDialogButtonBox,
    QLabel,
    QSpinBox,
)


BASE_DIR = Path(__file__).resolve().parent
ASSETS_DIR = BASE_DIR / "assets"
DATA_DIR = BASE_DIR / "data"
SETTINGS_FILE = DATA_DIR / "settings.json"

DATA_DIR.mkdir(exist_ok=True)


def asset(filename):
    return str(ASSETS_DIR / filename)


DEFAULT_SETTINGS = {
    "default_note_color": "#fff7a8",
    "auto_pin": True,
    "auto_save": True,
    "remember_position": True,
    "remember_size": True,
    "default_text_size": 16,
}


def load_settings():
    if not SETTINGS_FILE.exists():
        save_settings(DEFAULT_SETTINGS.copy())
        return DEFAULT_SETTINGS.copy()

    try:
        with open(SETTINGS_FILE, "r", encoding="utf-8") as file:
            data = json.load(file)

        settings = DEFAULT_SETTINGS.copy()
        settings.update(data)
        return settings

    except Exception:
        return DEFAULT_SETTINGS.copy()


def save_settings(settings):
    with open(SETTINGS_FILE, "w", encoding="utf-8") as file:
        json.dump(settings, file, indent=4)


def readable_text_color(background):
    color = QColor(background)

    brightness = (
        color.red() * 299
        + color.green() * 587
        + color.blue() * 114
    ) / 1000

    if brightness >= 145:
        return "#111111"
    return "#FFFFFF"


class NoteTextEdit(QTextEdit):
    def __init__(self, text_size):
        super().__init__()

        self.setAcceptRichText(True)
        self.setPlaceholderText("Type your note here...")

        font = QFont("Arial", text_size)
        self.setFont(font)

        self.setStyleSheet("""
            QTextEdit {
                border: none;
                padding: 12px;
                background: transparent;
            }
        """)


class NoteWindow(QWidget):
    def __init__(self, pt_note):
        super().__init__()

        self.pt_note = pt_note
        self.settings = pt_note.settings

        self.drag_position = None
        self.pinned = self.settings["auto_pin"]
        self.note_color = self.settings["default_note_color"]

        self.setWindowTitle("PTNote")
        self.setWindowIcon(QIcon(asset("PTNote.ico")))

        self.resize(450, 350)

        self.editor = NoteTextEdit(
            self.settings["default_text_size"]
        )

        self.close_button = self.create_button(
            "close.png",
            self.close_note
        )

        self.color_button = self.create_button(
            "color.png",
            self.change_color
        )

        self.pin_button = self.create_button(
            "pin.png",
            self.toggle_pin
        )

        toolbar = QHBoxLayout()
        toolbar.setContentsMargins(8, 8, 8, 8)
        toolbar.setSpacing(6)

        toolbar.addWidget(self.close_button)
        toolbar.addWidget(self.color_button)
        toolbar.addWidget(self.pin_button)
        toolbar.addStretch()

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        layout.addLayout(toolbar)
        layout.addWidget(self.editor)

        self.apply_window_flags()
        self.update_style(self.note_color)

        self.editor.textChanged.connect(self.content_changed)

    def create_button(self, filename, function):
        button = QPushButton()

        icon_path = asset(filename)

        button.setIcon(QIcon(icon_path))
        button.setIconSize(QPixmap(icon_path).size())
        button.setFixedSize(32, 32)

        button.setStyleSheet("""
            QPushButton {
                border: none;
                background: transparent;
                padding: 4px;
            }

            QPushButton:hover {
                background: rgba(0, 0, 0, 25);
                border-radius: 5px;
            }

            QPushButton:pressed {
                background: rgba(0, 0, 0, 45);
                border-radius: 5px;
            }
        """)

        button.clicked.connect(function)

        return button

    def apply_window_flags(self):
        flags = (
            Qt.WindowType.FramelessWindowHint
            | Qt.WindowType.Window
        )

        if self.pinned:
            flags |= Qt.WindowType.WindowStaysOnTopHint

        self.setWindowFlags(flags)

    def update_style(self, background):
        self.note_color = background

        text_color = readable_text_color(background)

        self.setStyleSheet(f"""
            QWidget {{
                background: {background};
            }}

            QTextEdit {{
                background: {background};
                border: none;
                padding: 12px;
                font-size: 16px;
                color: {text_color};
            }}

            QPushButton {{
                border: none;
                background: transparent;
                padding: 4px;
            }}

            QPushButton:hover {{
                background: rgba(0, 0, 0, 25);
                border-radius: 5px;
            }}

            QPushButton:pressed {{
                background: rgba(0, 0, 0, 45);
                border-radius: 5px;
            }}
        """)

        palette = self.editor.palette()
        palette.setColor(
            QPalette.ColorRole.Text,
            QColor(text_color)
        )
        palette.setColor(
            QPalette.ColorRole.PlaceholderText,
            QColor(text_color)
        )

        self.editor.setPalette(palette)

    def change_color(self):
        color = QColorDialog.getColor(
            QColor(self.note_color),
            self,
            "Choose Note Color"
        )

        if color.isValid():
            self.update_style(color.name())

    def toggle_pin(self):
        self.pinned = not self.pinned

        self.apply_window_flags()
        self.show()
        self.raise_()
        self.activateWindow()

        self.pt_note.refresh_tray_menu()

    def content_changed(self):
        if self.settings["auto_save"]:
            self.save_note()

        self.pt_note.refresh_tray_menu()

    def save_note(self):
        # Basic note saving will be expanded into the
        # full note database system next.
        pass

    def close_note(self):
        self.close()

    def closeEvent(self, event):
        self.pt_note.note_closed(self)
        event.accept()

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.drag_position = (
                event.globalPosition().toPoint()
                - self.frameGeometry().topLeft()
            )
            event.accept()

    def mouseMoveEvent(self, event):
        if (
            event.buttons() & Qt.MouseButton.LeftButton
            and self.drag_position is not None
        ):
            self.move(
                event.globalPosition().toPoint()
                - self.drag_position
            )
            event.accept()

    def mouseReleaseEvent(self, event):
        self.drag_position = None


class SettingsWindow(QDialog):
    def __init__(self, pt_note):
        super().__init__(pt_note.main_window if hasattr(pt_note, "main_window") else None)

        self.pt_note = pt_note
        self.settings = pt_note.settings

        self.setWindowTitle("PTNote Options")
        self.setWindowIcon(QIcon(asset("PTNote.ico")))
        self.setMinimumWidth(400)

        layout = QVBoxLayout(self)

        title = QLabel("PTNote Settings")
        title.setFont(QFont("Arial", 18, QFont.Weight.Bold))
        layout.addWidget(title)

        # Default note color
        color_layout = QHBoxLayout()

        color_label = QLabel("Default note color")
        color_layout.addWidget(color_label)

        self.color_button = QPushButton()
        self.color_button.setText(self.settings["default_note_color"])
        self.color_button.clicked.connect(self.choose_color)

        color_layout.addWidget(self.color_button)
        layout.addLayout(color_layout)

        # Auto-pin
        self.auto_pin = QCheckBox("Auto-pin")
        self.auto_pin.setChecked(
            self.settings["auto_pin"]
        )
        layout.addWidget(self.auto_pin)

        # Auto-save
        self.auto_save = QCheckBox("Auto-save")
        self.auto_save.setChecked(
            self.settings["auto_save"]
        )
        layout.addWidget(self.auto_save)

        # Remember position
        self.remember_position = QCheckBox(
            "Remember note position"
        )
        self.remember_position.setChecked(
            self.settings["remember_position"]
        )
        layout.addWidget(self.remember_position)

        # Remember size
        self.remember_size = QCheckBox(
            "Remember note size"
        )
        self.remember_size.setChecked(
            self.settings["remember_size"]
        )
        layout.addWidget(self.remember_size)

        # Text size
        text_size_layout = QHBoxLayout()

        text_size_layout.addWidget(
            QLabel("Default text size")
        )

        self.text_size = QSpinBox()
        self.text_size.setRange(8, 72)
        self.text_size.setValue(
            self.settings["default_text_size"]
        )

        text_size_layout.addWidget(self.text_size)
        layout.addLayout(text_size_layout)

        layout.addStretch()

        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Save
            | QDialogButtonBox.StandardButton.Cancel
        )

        buttons.accepted.connect(self.save)
        buttons.rejected.connect(self.reject)

        layout.addWidget(buttons)

    def choose_color(self):
        color = QColorDialog.getColor(
            QColor(self.settings["default_note_color"]),
            self,
            "Choose Default Note Color"
        )

        if color.isValid():
            self.settings["default_note_color"] = color.name()
            self.color_button.setText(color.name())

    def save(self):
        self.settings["auto_pin"] = self.auto_pin.isChecked()
        self.settings["auto_save"] = self.auto_save.isChecked()
        self.settings["remember_position"] = (
            self.remember_position.isChecked()
        )
        self.settings["remember_size"] = (
            self.remember_size.isChecked()
        )
        self.settings["default_text_size"] = (
            self.text_size.value()
        )

        save_settings(self.settings)

        self.pt_note.settings = self.settings

        self.accept()


class PTNoteApp:
    def __init__(self, qt_app):
        self.qt_app = qt_app

        self.settings = load_settings()

        self.notes = []
        self.settings_window = None

        self.tray = QSystemTrayIcon(
            QIcon(asset("PTNote.ico")),
            qt_app
        )

        self.tray.setToolTip("PTNote")

        self.menu = QMenu()

        self.tray.setContextMenu(self.menu)

        self.tray.activated.connect(
            self.tray_clicked
        )

        self.refresh_tray_menu()

        self.tray.show()

    def refresh_tray_menu(self):
        self.menu.clear()

        new_note = self.menu.addAction("New Note")
        new_note.triggered.connect(self.new_note)

        if self.notes:
            self.menu.addSeparator()

            notes_menu = self.menu.addMenu("Notes")

            for index, note in enumerate(self.notes):
                text = note.editor.toPlainText().strip()

                if not text:
                    text = "Untitled Note"
                else:
                    text = text.replace("\n", " ")

                    if len(text) > 35:
                        text = text[:35] + "..."

                action = notes_menu.addAction(text)
                action.triggered.connect(
                    lambda checked=False, n=note:
                    self.open_note(n)
                )

        self.menu.addSeparator()

        options = self.menu.addAction(
            QIcon(asset("options.png")),
            "Options"
        )
        options.triggered.connect(
            self.show_options
        )

        self.menu.addSeparator()

        exit_action = self.menu.addAction(
            "Exit PTNote"
        )
        exit_action.triggered.connect(
            self.exit
        )

    def new_note(self):
        note = NoteWindow(self)

        offset = len(self.notes) * 30

        note.move(
            100 + offset,
            100 + offset
        )

        note.show()
        note.raise_()
        note.activateWindow()

        self.notes.append(note)

        self.refresh_tray_menu()

    def open_note(self, note):
        if note.isMinimized():
            note.showNormal()

        note.show()
        note.raise_()
        note.activateWindow()

    def note_closed(self, note):
        if note in self.notes:
            self.notes.remove(note)

        self.refresh_tray_menu()

    def tray_clicked(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self.new_note()

    def show_options(self):
        if (
            self.settings_window is not None
            and self.settings_window.isVisible()
        ):
            self.settings_window.raise_()
            self.settings_window.activateWindow()
            return

        self.settings_window = SettingsWindow(self)
        self.settings_window.exec()

        self.settings_window = None

    def exit(self):
        for note in self.notes[:]:
            note.close()

        self.notes.clear()

        self.tray.hide()

        self.qt_app.quit()


def main():
    app = QApplication(sys.argv)

    app.setApplicationName("PTNote")
    app.setApplicationDisplayName("PTNote")
    app.setWindowIcon(QIcon(asset("PTNote.ico")))

    app.setQuitOnLastWindowClosed(False)

    pt_note = PTNoteApp(app)

    # Keep the PTNote application object alive.
    app.pt_note = pt_note

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
